# =============================================================================
# Front-Page Flip Backend Production Configuration (Render Deployment)
# =============================================================================
PORT=8080

# 1. Aiven MySQL Database Connection
# Connect with defaultdb and SSL enabled (matches Aiven MySQL Cloud)
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=your-aiven-port
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_mysql_password
DB_USE_SSL=true
DB_REQUIRE_SSL=true

# 2. Security & JWT Configuration (min 32 bytes hex key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# 3. Designated Administrator / Creator
CREATOR_EMAIL=your_admin_email@example.com
ADMIN_INITIAL_PASSWORD=your_master_admin_passphrase

# 4. Social OAuth 2.0 / OpenID Connect (Student Login)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# 5. Brevo SMTP & API Email Delivery (Dual Transport)
# Recommended for Render Free/Starter: Use BREVO_API_KEY over standard HTTPS (Port 443)
# to prevent outbound TCP port 587 timeouts from cloud firewalls.
BREVO_API_KEY=xkeysib-your_brevo_v3_api_key

# Alternatively, configure Brevo SMTP Relay:
# Host: smtp-relay.brevo.com
# Ports supported: 587 (STARTTLS), 2525 (alternate STARTTLS), 465 (SSL)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# Username is your Brevo login email or SMTP user key (e.g., 7c4b1...@smtp-brevo.com)
MAIL_USERNAME=your_brevo_smtp_login
# Password is your Brevo SMTP key (from Brevo > SMTP & API > Generate a new SMTP key)
MAIL_PASSWORD=your_brevo_smtp_master_key
# IMPORTANT: MAIL_FROM must be a verified sender email in your Brevo account (Senders & IP)
MAIL_FROM=frontpageflipofficial@gmail.com

# 6. Deployment & CORS Configuration
FRONTEND_URL=https://frontpageflip.vercel.app
CORS_ALLOWED_ORIGINS=https://frontpageflip.vercel.app,https://*.vercel.app,http://localhost:3000,http://localhost:5173

# 7. PDF Storage & Cloudinary Configuration (Render Environment Variables)
STORAGE_TYPE=cloudinary
STORAGE_DIR=./uploads/pdfs
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=front-page-flip/pdfs

# 8. Razorpay Standard Payment Gateway (Production Live Credentials)
RAZORPAY_KEY_ID=rzp_live_TwReofbXIfEGXk
RAZORPAY_KEY_SECRET=ipp92NPh5OIoyX9bWr9qmRlF
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_optional

