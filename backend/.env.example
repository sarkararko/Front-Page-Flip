# Front-Page Flip Backend Environment Variables
SERVER_PORT=8080

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=frontpageflip
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# Authentication & JWT Configuration
# Must be at least 256 bits (32 bytes) hex/base64 encoded key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Strictly Authorized Administrator / Creator Email
# Only this email is allowed to authenticate via /api/v1/auth/admin/login
CREATOR_EMAIL=arkaparna.ds@gmail.com

# PDF File Storage Abstraction (local disk or AWS S3)
STORAGE_TYPE=local
STORAGE_DIR=./uploads/pdfs

# Optional AWS S3 Configuration (when STORAGE_TYPE=s3)
S3_BUCKET=frontpageflip-production-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mail / Verification Delivery (SendGrid, Mailgun, or standard SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_api_key

# Frontend Allowed CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
